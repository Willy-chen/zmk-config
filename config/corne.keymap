#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
// |  ESC |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
// | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
// | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | TAB  |
//                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |
                        display-name = "Default";
                        bindings = <
   &kp ESC   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
   &kp LCTRL &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp SEMI &kp SQT
   &kp LSHFT &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp TAB
                  &kp LGUI &mo 1 &kp SPACE   &kp RET &mo 2 &kp RALT
                        >;
                };
                lower_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
// | LCTRL|     | LFT | DWN |  UP | RGT |   | LFT | DWN |  UP | RGT |     |      |
// | SHFT | BRM | BRD | BRU | BRM | BTA |   |     |     |     |     |     |      |
//                    | ALT |     | SPC |   | ENT |     | ALT |
                        display-name = "Lower";
                        bindings = <
   &kp TAB   &kp N1        &kp N2        &kp N3       &kp N4        &kp N5           &kp N6   &kp N7    &kp N8    &kp N9    &kp N0 &kp BSPC
   &kp LCTRL &trans        &kp LEFT      &kp DOWN     &kp UP        &kp RIGHT        &kp LEFT &kp DOWN  &kp UP    &kp RIGHT &trans &kp DEL
   &kp LSHFT &kp C_BRI_MIN &kp C_BRI_DN  &kp C_BRI_UP &kp C_BRI_MAX &kp C_BRI_AUTO   &trans   &kp PG_DN &kp PG_UP &trans    &trans &trans
                                         &kp LALT     &trans        &kp SPACE        &kp RET  &mo 3     &kp RALT
                        >;
                };

                raise_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
// | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
// | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
//                    | GUI |     | SPC |   | ENT |     | ALT |
                        display-name = "Raise";
                        bindings = <
   &kp  TAB  &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp ASTRK &kp LPAR &kp RPAR &kp BSPC
   &kp LCTRL &trans   &trans &trans   &trans   &trans      &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT &kp BSLH &kp GRAVE
   &kp LSHFT &trans   &trans &trans   &trans   &trans      &kp UNDER &kp PLUS  &kp LBRC  &kp RBRC &kp PIPE &kp TILDE
                             &kp LGUI &mo 3   &kp SPACE   &kp RET   &trans    &kp RALT
                        >;
                };

                adjust_layer {
// -----------------------------------------------------------------------------------------
// |  F1      |  F2   |  F3   |  F4   |  F5   |  F6   |   |  F7   |  F8   |  F9   |  F10  |  F11  |  F12  |
// |  UG_BKLT |  BRI  |  HUI  |  SAI  |  SPI  |  EFF  |   | BTCLR |  BT0  |  BT1  |  BT2  |  BT3  |  BT4  |     
// |  UG_RGB  |  BRD  |  HUD  |  SAD  |  SPD  |  EFR  |   |       |  MUTE | VOL_D | VOL_U |       |  PLV  |
//                            |  GUI  |       |  SPC  |   |  ENT  |       |  ALT  |
                        display-name = "Adjust"; 
                        bindings = <
   &kp  F1         &kp F2          &kp F3          &kp F4          &kp F5           &kp F6             &kp F7      &kp F8       &kp F9       &kp F10      &kp F11      &kp F12
   &kp C_BKLT_TOG  &rgb_ug RGB_BRI &rgb_ug RGB_HUI &rgb_up RGB_SAI &rgb_ug RGB_SPI  &rgb_up RGB_EFF    &bt BT_CLR  &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4
   &rgb_ug RGB_TOG &rgb_ug RGB_BRD &rgb_up RGB_HUD &rgb_ug RGB_SAD &rgb_ug RGB_SPD  &rgb_up RGB_EFR    &trans      &kp C_MUTE   &kp C_VOL_DN &kp C_VOL_UP &trans       &tog 4
                                                   &kp LGUI        &trans           &kp SPACE          &kp RET     &trans       &kp RALT
                        >;
                };


    steno_layer {
// -----------------------------------------------------------------------------------------
// |     |  #  |  T  |  P  |  H  |  *  |   |  *  |  F  |  P  |  L  |  T  |  D  |
// |     |  S  |  K  |  W  |  R  |  *  |   |  *  |  R  |  B  |  G  |  S  |  Z  |
// |     |     |     |  A  |  O  |     |   |     |  E  |  U  |     |     | PLV  |
//   
                display-name = "Steno";
                bindings = <
                &none &kp PLV_NM &kp PLV_TL &kp PLV_PL &kp PLV_HL &kp PLV_ST   &kp PLV_ST &kp PLV_FR &kp PLV_PR &kp PLV_LR &kp PLV_TR &kp PLV_DR
                &none &kp PLV_SL &kp PLV_KL &kp PLV_WL &kp PLV_RL &kp PLV_ST   &kp PLV_ST &kp PLV_RR &kp PLV_BR &kp PLV_GR &kp PLV_SR &kp PLV_ZR
                &none &none &none &none &none &none   &none &none &none &none &none &tog 4
                                &kp PLV_A &kp PLV_O &none   &none &kp PLV_E &kp PLV_U
                        >;
                };
        };
};

&led_strip {
    chain-length = <27>;
};